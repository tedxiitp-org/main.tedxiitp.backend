NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/ted-temp
JWT_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret

SUPERADMIN_EMAIL=admin@tedxiitpatna.iitp.ac.in
SUPERADMIN_PASSWORD=change_me_at_least_8_chars

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TEDxIIT Patna <no-reply@tedxiitpatna.iitp.ac.in>

# Option A: public sheet (no credentials). Set link sharing to "Anyone with the link can view".
# GOOGLE_SHEETS_ID is the long id in the sheet URL: /spreadsheets/d/<THIS_PART>/edit
# GOOGLE_SHEETS_GID is the tab id, shown as #gid=<NUMBER> in the URL (0 for the first tab).
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_GID=0

GOOGLE_SHEETS_RANGE=Form Responses 1

# Shared secret for the Google Form submit webhook
SHEET_WEBHOOK_SECRET=

# Google Sheets access. Paste the ENTIRE downloaded service account JSON key file
# on ONE line below (minify it), or base64 encode it. Then share the sheet with the
# client_email from that file as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared secret for the external batch runner
JOB_RUNNER_SECRET=
