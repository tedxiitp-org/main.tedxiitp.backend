# Option A: public sheet (no credentials). Set link sharing to "Anyone with the link can view".
# GOOGLE_SHEETS_ID is the long id in the sheet URL: /spreadsheets/d/<THIS_PART>/edit
# GOOGLE_SHEETS_GID is the tab id, shown as #gid=<NUMBER> in the URL (0 for the first tab).
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_GID=0

# Option B: private sheet via a service account. Share the sheet with the address below.
# Paste the whole private key on one line with literal backslash-n escapes preserved.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEETS_RANGE=Form Responses 1

# Shared secret for the Google Form submit webhook
SHEET_WEBHOOK_SECRET=
