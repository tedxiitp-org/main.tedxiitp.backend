{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "esModuleInterop": true,
    "types": [],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "exclude": [
    "src/config/**/*",
    "src/features/auth/**/*",
    "src/types/**/*",
    "src/middleware/authenticate.ts",
    "src/features/qr/seed.ts"
  ],
  "include": [
    "src/server.ts",
    "src/features/mail/services/worker.ts"
  ]
}
